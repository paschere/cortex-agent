{
  "name": "cortex-agent",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "test:e2e": "turbo test:e2e",
    "browser:bench": "pnpm --filter @cortex/browser-service build && ./services/browser/node_modules/.bin/tsx scripts/browser-benchmark/run.ts",
    "browser:cases": "pnpm --filter @cortex/browser-service build && ./services/browser/node_modules/.bin/tsx scripts/browser-cases/run.ts",
    "format": "biome format --write .",
    "db:start": "supabase --workdir infra start",
    "db:stop": "supabase --workdir infra stop",
    "db:reset": "supabase --workdir infra db reset",
    "db:push": "supabase --workdir infra db push",
    "deploy:migrate": "node scripts/deploy-migrate.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "turbo": "2.3.3",
    "typescript": "5.7.2",
    "@types/node": "20.17.10",
    "supabase": "1.219.2"
  }
}
