# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_URL=postgresql://postgres:postgres@localhost:54322/postgres

# App
APP_BASE_URL=http://localhost:3000
SESSION_COOKIE_NAME=zipdev_session
ALLOWED_EMAIL_DOMAIN=zipdev.com

# better-auth (Google SSO + session management)
# Generate: openssl rand -base64 32
# IMPORTANT (claude.ai MCP connector): in production BETTER_AUTH_URL must be the
# PUBLIC https origin (e.g. https://app.zipdev.com), not localhost. The OAuth
# issuer advertised in /.well-known metadata derives from this origin, so
# claude.ai will reject the connector if it points anywhere but the public host.
# Keep APP_BASE_URL aligned to the same public https origin.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Google OAuth (per-user integrations, separate from Supabase SSO config)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/integrations/google/callback

# HubSpot OAuth
HUBSPOT_CLIENT_ID=
HUBSPOT_CLIENT_SECRET=
HUBSPOT_REDIRECT_URI=http://localhost:3000/api/integrations/hubspot/callback

# Gemini
GOOGLE_GENERATIVE_AI_API_KEY=

# Rate Estimator service-token
RATE_ESTIMATOR_URL=https://rate.zipdev.internal
RATE_ESTIMATOR_SERVICE_TOKEN=

# Inngest
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# Token encryption (32-byte base64). Generate: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=

# Recruiting (zipdev-matcher) + Slack
ZIPDEV_MATCHER_URL=http://localhost:3100
ZIPDEV_MATCHER_TOKEN=
SLACK_BOT_TOKEN=

# Apollo.io prospecting (workspace-wide API key, metered — enrichment costs credits)
APOLLO_API_KEY=

# BambooHR — the HR system of record (roster, time off, documents, pay and bill
# rates). One workspace-wide key, sent as HTTP Basic. The same credential the
# payroll app uses; read-only as far as this app is concerned.
# BAMBOOHR_BASE_URL defaults to the Zipdev gateway when left unset.
BAMBOOHR_API=
BAMBOOHR_BASE_URL=https://api.bamboohr.com/api/gateway.php/zipdev/v1

# Zippy picks up its own development work (docs/operations/zippy-dev-tasks.md)
# LINEAR_WEBHOOK_SECRET is shown once when the webhook is created in Linear
# (Settings → API → Webhooks, URL <APP_BASE_URL>/api/webhooks/linear). Without
# it the endpoint rejects EVERY request, in every environment.
LINEAR_WEBHOOK_SECRET=
# What makes Zippy take an issue: assignee (default, recommended) | label | either
LINEAR_TRIGGER_MODE=assignee
# Zippy's own Linear account — the user id an issue must be assigned to.
LINEAR_ZIPPY_USER_ID=
LINEAR_ZIPPY_USER_EMAIL=
# Label that fires the trigger in label/either mode.
LINEAR_TRIGGER_LABEL=zippy
# Whose Linear token Zippy comments with (a webhook has no signed-in user).
# Defaults to whichever Zipdev account connected Linear first.
ZIPPY_LINEAR_ACTOR_EMAIL=

# --- Executor (dev-task-run): turns a queued task into a pull request ---
# The coding model. This is deliberately NOT the Gemini key the chat path uses:
# writing and verifying code is a different job. Without it, runs fail at once.
ANTHROPIC_API_KEY=
# Vercel Sandbox does the cloning, installing and building. On Vercel these are
# supplied automatically via OIDC; set them only for local runs.
VERCEL_TOKEN=
VERCEL_TEAM_ID=
VERCEL_PROJECT_ID=
# GitHub credential for the executor. PREFER the App: GitHub itself confines an
# installation token to ONE repository and expires it in an hour, which is
# exactly the blast radius a sandbox should hold.
GITHUB_APP_ID=
GITHUB_APP_INSTALLATION_ID=
# PEM, with literal \n between lines if your secret store is single-line.
GITHUB_APP_PRIVATE_KEY=
# Fallback when no App is configured. Must be a FINE-GRAINED PAT restricted to
# the repositories in dev_repositories — a classic PAT grants far too much.
DEV_TASK_GITHUB_TOKEN=
# Hard budget per run. Exhausting any axis ends the run with a written reason
# instead of looping. Defaults: 30 min, 40 model turns, 1.5M tokens (~$12).
DEV_TASK_MAX_WALL_MS=1800000
DEV_TASK_MAX_ITERATIONS=40
DEV_TASK_MAX_TOKENS=1500000

# Observability
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
