# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_URL=postgresql://postgres:postgres@localhost:54322/postgres

# App
APP_BASE_URL=http://localhost:3000
SESSION_COOKIE_NAME=cortex_session
# SaaS default: leave empty for open signup. Set a domain (e.g. acme.com) to
# turn a deployment into a single-company instance.
ALLOWED_EMAIL_DOMAIN=

# The workspace's own email domains, comma-separated (e.g. acme.com,acme.co.uk).
# Decides who counts as a colleague: meeting classification uses it to tell an
# internal sync from a client call, and the security layer uses it to tell
# whether a tool call is about to push data OUT of the company.
# EMPTY MEANS NOBODY IS INTERNAL. That is the safe default for a fresh
# multi-tenant deployment — every recipient reads as external, so outbound
# sends ask for confirmation rather than slipping through unnoticed. Set it and
# internal traffic stops asking.
INTERNAL_EMAIL_DOMAINS=

# Transactional email (verification, password reset, org invitations).
# Optional in dev — without RESEND_API_KEY the links are printed to the
# server log instead of being emailed.
RESEND_API_KEY=
EMAIL_FROM="Cortex <onboarding@resend.dev>"

# better-auth (Google SSO + session management)
# Generate: openssl rand -base64 32
# IMPORTANT (claude.ai MCP connector): in production BETTER_AUTH_URL must be the
# PUBLIC https origin (e.g. https://app.cortex.example), not localhost. The OAuth
# issuer advertised in /.well-known metadata derives from this origin, so
# claude.ai will reject the connector if it points anywhere but the public host.
# Keep APP_BASE_URL aligned to the same public https origin.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Google OAuth (per-user integrations, separate from Supabase SSO config)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/integrations/google/callback

# HubSpot OAuth
HUBSPOT_CLIENT_ID=
HUBSPOT_CLIENT_SECRET=
HUBSPOT_REDIRECT_URI=http://localhost:3000/api/integrations/hubspot/callback

# Claude — every generating call (chat, agents, routines) runs on it.
# Required: without it the chat surface fails on the first turn.
ANTHROPIC_API_KEY=

# Voyage AI — EMBEDDINGS ONLY (voyage-3-large at 1024 dims, the dimension the
# pgvector column and its HNSW index are built for). Anthropic ships no
# embedding endpoint, and Voyage is the provider it recommends.
# Without it the Knowledge Base degrades rather than breaking: documents are
# still stored and chunked, search still matches on keywords, and everything
# saved meanwhile is queued with no vector. Add the key and the
# kb-reindex-embeddings job fills in the backlog on its next run (or run
# `node scripts/reembed-kb.mjs` to not wait). Nothing is lost, but until it is
# set nobody can find anything by MEANING — only by the words they typed.
VOYAGE_API_KEY=

# Gemini is no longer used anywhere: generation runs on Claude and embeddings
# run on Voyage. The variable is listed only so a deployment that still carries
# it knows it can be deleted.
# GOOGLE_GENERATIVE_AI_API_KEY=

# Deepgram — speech to text for Knowledge Base audio (nova-3, diarized).
# Every voice memo, call recording and in-browser recording goes through it;
# without a key the audio is still stored and the document row still exists,
# but transcription stops at `transcript_status = 'failed'` with a plain
# sentence saying the workspace has no Deepgram key, and the recording is
# NOT searchable — there is nothing to embed until it has been transcribed.
# Set the key later and re-uploading the file picks it up.
DEEPGRAM_API_KEY=

# Web search (Tavily). web.search fails on its first call without it; web.scrape
# still works, falling back to Jina's reader when FIRECRAWL_API_KEY is unset.
TAVILY_API_KEY=

# Optional. Improves web.scrape on pages that need rendering; without it the
# tool falls back to a free reader that handles most pages fine.
FIRECRAWL_API_KEY=

# Inngest
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# Token encryption (32-byte base64). Generate: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=

# Matcher service + Slack.
# The matcher is the upstream service behind the presentations.* tools — it
# stores the candidate records and renders the letterheaded PDF. MATCHER_TOKEN
# is the service token it expects as a bearer. Without both, presentations.*
# report that they have nowhere to ask instead of inventing a candidate.
MATCHER_URL=http://localhost:3100
MATCHER_TOKEN=
SLACK_BOT_TOKEN=

# Vehicles (Colombia) — the self-hosted consult service that answers RUNT
# (national vehicle registry: SOAT and RTM validity) and SIMIT (traffic fines).
# Neither is an API: both are scraped, and a RUNT consult drives a headless
# browser through an OCR captcha for ~18 seconds. The key is sent as x-api-key
# and must match SCRAPER_API_KEY on the service.
# Leave both empty and the vehicles.* tools degrade instead of failing: plates
# can still be registered and listed, and every lookup reports plainly that it
# has nowhere to ask.
VEHICLES_SCRAPER_URL=
VEHICLES_SCRAPER_API_KEY=

# Cortex picks up its own development work (docs/operations/cortex-dev-tasks.md)
# LINEAR_WEBHOOK_SECRET is shown once when the webhook is created in Linear
# (Settings → API → Webhooks, URL <APP_BASE_URL>/api/webhooks/linear). Without
# it the endpoint rejects EVERY request, in every environment.
LINEAR_WEBHOOK_SECRET=
# What makes Cortex take an issue: assignee (default, recommended) | label | either
LINEAR_TRIGGER_MODE=assignee
# Cortex's own Linear account — the user id an issue must be assigned to.
LINEAR_CORTEX_USER_ID=
LINEAR_CORTEX_USER_EMAIL=
# Label that fires the trigger in label/either mode.
LINEAR_TRIGGER_LABEL=cortex
# Whose Linear token Cortex comments with (a webhook has no signed-in user).
# Defaults to whichever account in the workspace connected Linear first.
CORTEX_LINEAR_ACTOR_EMAIL=

# --- Executor (dev-task-run): turns a queued task into a pull request ---
# The coding model uses the same ANTHROPIC_API_KEY declared at the top of this
# file — since the chat path moved to Claude, the two no longer differ.
# Vercel Sandbox does the cloning, installing and building. On Vercel these are
# supplied automatically via OIDC; set them only for local runs.
VERCEL_TOKEN=
VERCEL_TEAM_ID=
VERCEL_PROJECT_ID=
# GitHub credential for the executor. PREFER the App: GitHub itself confines an
# installation token to ONE repository and expires it in an hour, which is
# exactly the blast radius a sandbox should hold.
GITHUB_APP_ID=
GITHUB_APP_INSTALLATION_ID=
# PEM, with literal \n between lines if your secret store is single-line.
GITHUB_APP_PRIVATE_KEY=
# Fallback when no App is configured. Must be a FINE-GRAINED PAT restricted to
# the repositories in dev_repositories — a classic PAT grants far too much.
DEV_TASK_GITHUB_TOKEN=
# Hard budget per run. Exhausting any axis ends the run with a written reason
# instead of looping. Defaults: 30 min, 40 model turns, 1.5M tokens (~$12).
DEV_TASK_MAX_WALL_MS=1800000
DEV_TASK_MAX_ITERATIONS=40
DEV_TASK_MAX_TOKENS=1500000

# Observability
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=

# ---------------------------------------------------------------------------
# WhatsApp (docs/operations/whatsapp.md)
# ---------------------------------------------------------------------------
# WhatsApp publishes no API for reading the groups an account belongs to, so
# this runs on Baileys — an UNOFFICIAL client — inside a persistent service
# (services/whatsapp) deployed on Railway. It cannot run on Vercel: the client
# holds a WebSocket open for days and a serverless invocation ends.
#
# Use a DEDICATED COMPANY NUMBER. WhatsApp can ban a number for using an
# unofficial client; never pair somebody's personal line.

# The shared secret between Cortex and the bridge, compared in constant time.
# Set the SAME value here (Vercel) and on the Railway service.
# Generate: openssl rand -base64 32
# WITHOUT IT, every /api/whatsapp/bridge/* route refuses — which is the right
# default for a surface whose job is to receive other people's conversations.
# Treat it like SUPABASE_SERVICE_ROLE_KEY: it names the workspace it acts for,
# so it is operator infrastructure and never goes near a browser or a customer.
WHATSAPP_BRIDGE_TOKEN=

# --- set on the RAILWAY service only, not on Vercel -------------------------
# The public https origin of Cortex, e.g. https://app.cortex.example
# CORTEX_BASE_URL=
# The workspace this WhatsApp number belongs to (ba_organization.id). One
# bridge, one number, one workspace.
# WHATSAPP_ORGANIZATION_ID=
#
# Optional tuning, all with sane defaults:
#   WHATSAPP_BATCH_INTERVAL_MS  30000   how often buffered group messages are posted
#   WHATSAPP_BATCH_SIZE         50      …or after this many, whichever comes first
#   WHATSAPP_HEARTBEAT_MS       30000   status report + refresh of the archived-group list
#   WHATSAPP_INGEST_TICK_MS     300000  how often finished conversations become documents
#   WHATSAPP_MIN_BACKOFF_MS     2000    reconnect backoff floor
#   WHATSAPP_MAX_BACKOFF_MS     300000  reconnect backoff ceiling
#   WHATSAPP_MAX_VOICE_BYTES    12582912
#   WHATSAPP_MAX_DOCUMENT_BYTES 20971520
#
# Voice notes in archived groups are transcribed with the DEEPGRAM_API_KEY
# already declared above — no second provider and no second key. Without it the
# group is still archived and voice notes appear as "[voice note — not
# transcribed]"; everything written stays intact and searchable.
