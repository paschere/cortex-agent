# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_URL=postgresql://postgres:postgres@localhost:54322/postgres

# App
APP_BASE_URL=http://localhost:3000
SESSION_COOKIE_NAME=zipdev_session
ALLOWED_EMAIL_DOMAIN=zipdev.com

# better-auth (Google SSO + session management)
# Generate: openssl rand -base64 32
# IMPORTANT (claude.ai MCP connector): in production BETTER_AUTH_URL must be the
# PUBLIC https origin (e.g. https://app.zipdev.com), not localhost. The OAuth
# issuer advertised in /.well-known metadata derives from this origin, so
# claude.ai will reject the connector if it points anywhere but the public host.
# Keep APP_BASE_URL aligned to the same public https origin.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Google OAuth (per-user integrations, separate from Supabase SSO config)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/integrations/google/callback

# HubSpot OAuth
HUBSPOT_CLIENT_ID=
HUBSPOT_CLIENT_SECRET=
HUBSPOT_REDIRECT_URI=http://localhost:3000/api/integrations/hubspot/callback

# Gemini
GOOGLE_GENERATIVE_AI_API_KEY=

# Rate Estimator service-token
RATE_ESTIMATOR_URL=https://rate.zipdev.internal
RATE_ESTIMATOR_SERVICE_TOKEN=

# Inngest
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# Token encryption (32-byte base64). Generate: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=

# Recruiting (zipdev-matcher) + Slack
ZIPDEV_MATCHER_URL=http://localhost:3100
ZIPDEV_MATCHER_TOKEN=
SLACK_BOT_TOKEN=

# Apollo.io prospecting (workspace-wide API key, metered — enrichment costs credits)
APOLLO_API_KEY=

# Observability
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
